# =====================================================================
# Scout Careers — environment configuration (Phase 1)
# Copy to .env, chmod 600, replace every CHANGE_ME.
# Never commit .env. It is in .gitignore.
#
# Settings uses extra="forbid": a key that is not declared on the
# Settings object is a boot failure, not a silent no-op. This file
# therefore lists ONLY the Phase 1 keys. Later phases add their own.
# =====================================================================

# --- core ------------------------------------------------------------
SCOUT_ENV=local
SCOUT_BASE_URL=http://localhost:8000
TZ=Asia/Kolkata
APP_VERSION=dev

# --- database --------------------------------------------------------
# The +asyncpg marker is mandatory; a sync driver is refused at boot.
DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/scout
# Read by Docker Compose as well, so the password is written once.
POSTGRES_PASSWORD=scout
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_S=10.0
DATABASE_POOL_RECYCLE_S=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
# Local only — refused when SCOUT_ENV=production.
DATABASE_ECHO=false
# Deliberately off: migrations are a separate step before the new image serves.
DATABASE_MIGRATE_ON_BOOT=false

# --- redis -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_S=5.0
# Must exceed RUN_WALL_CLOCK_BUDGET_S, or the lock expires mid-run.
RUN_LOCK_TTL_S=3600
ROBOTS_CACHE_TTL_S=86400

# --- ingestion and sources -------------------------------------------
# Honest, identifying, contactable. Never a browser string, never rotated.
# Replace <operator> with a real address; required in production.
SOURCE_USER_AGENT=ScoutCareers/1.0 (personal job-search agent; +mailto:<operator>)
SOURCE_CONCURRENCY=8
SOURCE_PROBE_TIMEOUT_S=10.0
SOURCE_TIMEOUT_S=180
SOURCE_RETRY_BUDGET_S=90
RATE_LIMIT_WAIT_S=20
AUTO_DISABLE_THRESHOLD=5
CIRCUIT_BREAKER_FAILURES=5
MAX_DESCRIPTION_CHARS=60000
MAX_RESPONSE_BYTES=20971520
INGEST_CLOSE_AFTER_MISSED_RUNS=2
# Trigram similarity a parsed mail-alert employer name must reach before its
# posting is filed under a registered company (SOURCE_ADAPTERS.md §7.3). Below
# it the lead goes to the reserved `unmatched` company, where it stays visible.
# Lowering this mis-attributes, which is worse than missing: a mis-filed lead is
# indistinguishable from a real role at a company you already track.
ALERT_COMPANY_MATCH_THRESHOLD=0.45

# --- scheduler -------------------------------------------------------
RUN_WALL_CLOCK_BUDGET_S=900

# --- scheduler jobs --------------------------------------------------
# One process, and only one, may run the scheduler: two would produce two
# 08:00 discovery runs, the second of which the Redis run lock refuses and
# records as a refusal that reads like an incident. Off is the safe default.
SCHEDULER_ENABLED=false
# APScheduler creates and owns this table. It is deliberately not an Alembic
# migration and not in db/models.py.
SCHEDULER_JOBSTORE_TABLE=apscheduler_jobs
# How late a missed job may still run. 30 minutes covers a reboot or a laptop
# that woke at 08:20. Past it the run is skipped and triggered by hand —
# running yesterday's schedule six hours late is worse than not running it.
SCHEDULER_MISFIRE_GRACE_S=1800
# How long SIGTERM waits for an in-flight run before cancelling it.
SCHEDULER_SHUTDOWN_GRACE_S=60
# The daily discovery run, in TZ above. Storage and computation stay UTC;
# only the trigger is local.
DISCOVERY_CRON_HOUR=8
DISCOVERY_CRON_MINUTE=0

# --- gmail (mail/) ---------------------------------------------------
# Master switch for the mail module. Phase 1 reads the alert mailbox and
# sends nothing; the digest and its gmail.send scope are Phase 2.
# With this false, mail_alert sources are reported `disabled` — not
# attempted, nobody's fault, no failure counted against them.
MAIL_ENABLED=false
# The desktop OAuth client from the Google Cloud console. Either set these
# two, or point GMAIL_CLIENT_SECRETS_PATH at the downloaded JSON. An empty
# value means unset. Run `scout-careers auth gmail` for the walkthrough.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_CLIENT_SECRETS_PATH=
# The encrypted OAuth token. Mode 0600, outside the repo and outside every
# Docker build context. Written by `scout-careers auth gmail`.
MAIL_TOKEN_PATH=.secrets/gmail.token
# Fernet key encrypting that file. NEVER stored in the same place as the
# token. Without it the token is refused, never written in clear. Generate:
#   python -c "from cryptography.fernet import Fernet; \
#              print(Fernet.generate_key().decode())"
MAIL_TOKEN_KEY=
# Serialises token refresh so a scheduled poll and a manual run never race
# and invalidate each other's access token.
GMAIL_REFRESH_LOCK_TTL_S=30
# Ceiling on messages read per call. A bound, not a target — the alert
# adapter's lookback_hours is the real limit.
GMAIL_MAX_MESSAGES=100

# --- logging ---------------------------------------------------------
# DEBUG is refused in production.
LOG_LEVEL=INFO
LOG_FORMAT=console
