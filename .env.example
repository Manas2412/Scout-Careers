# =====================================================================
# Scout Careers — environment configuration (Phase 1)
# Copy to .env, chmod 600, replace every CHANGE_ME.
# Never commit .env. It is in .gitignore.
#
# Settings uses extra="forbid": a key that is not declared on the
# Settings object is a boot failure, not a silent no-op. This file
# therefore lists ONLY the Phase 1 keys. Later phases add their own.
# =====================================================================

# --- core ------------------------------------------------------------
SCOUT_ENV=local
SCOUT_BASE_URL=http://localhost:8000
TZ=Asia/Kolkata
APP_VERSION=dev

# --- database --------------------------------------------------------
# The +asyncpg marker is mandatory; a sync driver is refused at boot.
DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/scout
# Read by Docker Compose as well, so the password is written once.
POSTGRES_PASSWORD=scout
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_S=10.0
DATABASE_POOL_RECYCLE_S=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
# Local only — refused when SCOUT_ENV=production.
DATABASE_ECHO=false
# Deliberately off: migrations are a separate step before the new image serves.
DATABASE_MIGRATE_ON_BOOT=false

# --- redis -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_S=5.0
# Must exceed RUN_WALL_CLOCK_BUDGET_S, or the lock expires mid-run.
RUN_LOCK_TTL_S=3600
ROBOTS_CACHE_TTL_S=86400

# --- ingestion and sources -------------------------------------------
# Honest, identifying, contactable. Never a browser string, never rotated.
# Replace <operator> with a real address; required in production.
SOURCE_USER_AGENT=ScoutCareers/1.0 (personal job-search agent; +mailto:<operator>)
SOURCE_CONCURRENCY=8
SOURCE_PROBE_TIMEOUT_S=10.0
SOURCE_TIMEOUT_S=180
SOURCE_RETRY_BUDGET_S=90
RATE_LIMIT_WAIT_S=20
AUTO_DISABLE_THRESHOLD=5
CIRCUIT_BREAKER_FAILURES=5
MAX_DESCRIPTION_CHARS=60000
MAX_RESPONSE_BYTES=20971520
INGEST_CLOSE_AFTER_MISSED_RUNS=2
# Trigram similarity a parsed mail-alert employer name must reach before its
# posting is filed under a registered company (SOURCE_ADAPTERS.md §7.3). Below
# it the lead goes to the reserved `unmatched` company, where it stays visible.
# Lowering this mis-attributes, which is worse than missing: a mis-filed lead is
# indistinguishable from a real role at a company you already track.
ALERT_COMPANY_MATCH_THRESHOLD=0.45

# --- scheduler -------------------------------------------------------
RUN_WALL_CLOCK_BUDGET_S=900

# --- scheduler jobs --------------------------------------------------
# One process, and only one, may run the scheduler: two would produce two
# 08:00 discovery runs, the second of which the Redis run lock refuses and
# records as a refusal that reads like an incident. Off is the safe default.
SCHEDULER_ENABLED=false
# APScheduler creates and owns this table. It is deliberately not an Alembic
# migration and not in db/models.py.
SCHEDULER_JOBSTORE_TABLE=apscheduler_jobs
# How late a missed job may still run. 30 minutes covers a reboot or a laptop
# that woke at 08:20. Past it the run is skipped and triggered by hand —
# running yesterday's schedule six hours late is worse than not running it.
SCHEDULER_MISFIRE_GRACE_S=1800
# How long SIGTERM waits for an in-flight run before cancelling it.
SCHEDULER_SHUTDOWN_GRACE_S=60
# The daily discovery run, in TZ above. Storage and computation stay UTC;
# only the trigger is local.
DISCOVERY_CRON_HOUR=8
DISCOVERY_CRON_MINUTE=0

# --- stage 4, the deterministic filter (CONFIGURATION.md 8) ----------
# Zero model calls. This is what makes the cost model work: extraction is one
# call per surviving posting, and this decides how many survive. Tightening
# DEFAULT_LOCATION_FILTER is the first lever on LLM spend.
DEFAULT_LOCATION_FILTER=IN,Remote
# Bands the operator is not applying into. Tuned to a profile with ~6 months
# full-time plus substantial project ownership: entry, mid and senior stay.
# Staff and Principal are dropped because they realistically need 8+ years and
# are common on the big-tech boards tracked here. `unknown` is not listed and
# therefore passes — the source stating nothing is not grounds for dropping a
# role.
FILTER_SENIORITY_DENY=intern,staff,principal,manager,director,executive
# Whole-word, case-insensitive, matched against the TITLE only. Most-specific
# entry wins, so a multi-word phrase names the reason rather than one of its
# words.
#
# `firmware`, `rtos` and `device driver` were on this list and are deliberately
# NOT: the two Seagate roles that started this project were firmware roles, and
# a filter that hides the jobs you applied to is worse than no filter. What
# remains is non-engineering noise only.
FILTER_KEYWORD_DENY=sales,recruiter,teacher,nurse,driver,warehouse,account executive,counsel,customer success,technical support,accountant,paralegal,tax analyst,fp&a,strategic finance,treasury,payroll,credit risk,business controller,recruiting coordinator,talent sourcer,technical sourcer,executive assistant,executive business partner,people analytics,employee relations,benefits analyst,total rewards,talent acquisition,product designer,brand designer,motion designer,web designer,production designer,content designer,design systems lead,asic,rtl design,design verification,pcba,manufacturing engineer,data center,power trading,power delivery
# Years of experience a JD may demand before the role is out of reach.
# Compared against the LEAST demanding figure stated, so "8+ years overall,
# 3+ with Go" is kept and judged by scoring. A JD stating nothing passes and
# is surfaced as-is. 0 disables the check.
FILTER_MAX_YEARS_EXPERIENCE=5

# Go-to-market and developer-relations vocabulary, matched against the
# DESCRIPTION rather than the title — the titles that carry these roles
# ("Deployment Strategist", "Developer Advocate") contain no word a title list
# could catch. Every entry is a term a role where you write code does not use;
# `pipeline`, `customer`, `deal` and `outreach` alone are deliberately absent.
FILTER_ROLE_MARKER_DENY=quota,pipeline generation,outbound pipeline,prospecting,cold outreach,discovery calls,deal cycle,sales cycle,closing deals,book of business,upsell,cross-sell,icp,meddic,bant,on-target earnings,salesforce,gong,hubspot,developer advocate,developer advocacy,devrel,evangelism,on camera,on stage,conference talks,growing audience,twitch
# How many DISTINCT markers before a posting is dropped. Above one on purpose:
# an engineering advert mentions a quota now and then. Tune it against
# `scout-careers filter markers`, which shows the hit distribution over the
# surviving corpus and names every posting the next step down would move.
# 0 disables the predicate.
#
# Two was chosen by reading all 66 postings that sat at exactly two hits: every
# one was go-to-market. One was rejected by reading the 213 at a single hit,
# which include real engineering roles that mention Salesforce once.
FILTER_ROLE_MARKER_MIN=2
# Mail-alert stubs are never extracted. A two-line snippet yields garbage
# requirements, and garbage requirements produce a confident, wrong score.
ALERT_FIDELITY_EXTRACT=false

# --- scoring, stage 6 (MATCH_SCORING.md §13.1) ------------------------
# Deterministic: no model call, no token cost. Changing ANY key below means
# bumping SCORING_PROMPT_VERSION in the same commit — a formula change that
# reuses a version makes two incomparable score families indistinguishable in
# the database, and `prompt_version` is part of the unique key precisely so the
# old family survives for comparison.
SCORING_PROMPT_VERSION=score.v1
# w_hard: the blend between the hard and nice buckets. Hard coverage is what a
# screen actually reads.
SCORING_BLEND_HARD=0.80
# Credit for a `partial`. The one number in the formula whose right value is
# genuinely a matter of taste, which is why it is configuration.
SCORING_PARTIAL_CREDIT=0.50
# Minimum family adjacency for `partial`. Families looser than this score below
# it on purpose in scoring/adjacency.yaml, and so yield nothing.
SKILL_ADJACENCY_MIN=0.40
# T. A ±10% band: tier breaks a tie between comparable roles, and must never
# let a dream-tier role the operator cannot do outrank one they can.
SCORING_TIER_WEIGHT_DREAM=1.10
SCORING_TIER_WEIGHT_STRONG=1.00
SCORING_TIER_WEIGHT_VOLUME=0.90
# R. Grace because ATS boards lag the real posting date; a 45-day half-life
# because a role open six weeks is usually slow-moving or filled; a floor
# because an old posting is worth less, not worthless.
SCORING_RECENCY_GRACE_DAYS=14
SCORING_RECENCY_HALF_LIFE_DAYS=45
SCORING_RECENCY_FLOOR=0.65
# G. What makes hard coverage dominant rather than merely heavily weighted.
SCORING_HARD_GATE_PASS=0.60
SCORING_HARD_GATE_WARN=0.40
SCORING_HARD_GATE_WARN_FACTOR=0.85
SCORING_HARD_GATE_FAIL_FACTOR=0.65

# --- LLM provider (CONFIGURATION.md §5) ------------------------------
LLM_PROVIDER=bedrock
# Pinned, never a -latest alias: a model that changes without a deploy
# invalidates every eval result and every artifact's provenance.
LLM_MODEL_FAST=anthropic.claude-3-5-haiku-20241022-v1:0
LLM_MODEL_STRONG=anthropic.claude-sonnet-4-20250514-v1:0
LLM_MAX_CONCURRENCY=4

# Newer Anthropic models reject `temperature` outright — Bedrock answers
# "`temperature` is deprecated for this model". Declared per alias because
# `fast` and `strong` can sit on different generations. Cost of false:
# extraction is no longer pinned to temperature 0, so two runs over the same
# posting may differ. `bash scripts/llm-probe.sh fast` measures it.
LLM_TEMPERATURE_SUPPORTED_FAST=true
LLM_TEMPERATURE_SUPPORTED_STRONG=true

# --- bedrock credentials ---------------------------------------------
AWS_REGION=ap-south-1
# On a server with an instance role, leave both unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_ENDPOINT_URL=

# Ask Bedrock to cache the system prompt. Worth it for extraction, where one
# long rubric precedes hundreds of different job descriptions. Turn off if a
# model or region rejects the cachePoint block.
BEDROCK_PROMPT_CACHE_ENABLED=true

# --- cost and the budget breaker -------------------------------------
# Computed from the `usage` block on every response, never estimated.
LLM_DAILY_BUDGET_INR=80
LLM_BUDGET_WARN_PCT=80
LLM_INR_PER_USD=88
LLM_PRICE_FAST_IN=0.80
LLM_PRICE_FAST_OUT=4.00
LLM_PRICE_STRONG_IN=3.00
LLM_PRICE_STRONG_OUT=15.00

# --- prompt bounds and caching ---------------------------------------
# Truncated from the head: requirements come before benefits boilerplate.
# Also the bound on the cost attack — a 400,000-token JD is a bill.
EXTRACTION_MAX_JD_TOKENS=4000
LETTER_MAX_JD_TOKENS=900
LLM_CACHE_ENABLED=true
LLM_REQUEST_TIMEOUT_MULTIPLIER=1.0

# --- gmail (mail/) ---------------------------------------------------
MAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_CLIENT_SECRETS_PATH=
# Mode 0600, outside the repo and outside every Docker build context.
MAIL_TOKEN_PATH=.secrets/gmail.token
# Fernet key encrypting that file. NEVER stored beside the token.
MAIL_TOKEN_KEY=
GMAIL_REFRESH_LOCK_TTL_S=30
GMAIL_MAX_MESSAGES=100

# --- logging ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
